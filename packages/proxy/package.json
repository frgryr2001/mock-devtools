{
  "name": "@mock-devtools/proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mock-devtools-proxy": "./dist/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mock-devtools/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsdown": "^0.15.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
