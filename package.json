{
  "name": "mock-devtools-workspace",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:extension-release": "pnpm --filter @mock-devtools/chrome-extension build && node scripts/build-extension-release.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.17",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
